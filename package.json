{
  "name": "tanstack_start_ts",
  "private": true,
  "packageManager": "npm@10.9.4",
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite dev",
    "prebuild": "node ./scripts/clean-build-output.mjs && node ./scripts/validate-supabase-deployment-parity.mjs --vercel-build",
    "build": "vite build",
    "postbuild": "node ./scripts/finalize-build-output.mjs",
    "start": "node --env-file=.env.local ./scripts/serve-local-qa-runtime.mjs",
    "serve:local": "node --env-file=.env.local ./scripts/serve-local-qa-runtime.mjs --host 127.0.0.1 --port 3000",
    "qa:server:status": "node ./scripts/qa-local-server.mjs status",
    "qa:server:start": "node ./scripts/qa-local-server.mjs start",
    "qa:server:restart": "node ./scripts/qa-local-server.mjs restart",
    "qa:server:stop": "node ./scripts/qa-local-server.mjs stop",
    "local:fixture": "HITO_AI_GENERATED_PLAN_DEV_FIXTURE_DELAY_MS=15000 node ./scripts/qa-local-server.mjs restart --provider-mode qa_fixture",
    "local:real": "node ./scripts/qa-local-server.mjs restart --provider-mode real",
    "local:logs": "node --import tsx ./scripts/query-local-runtime-events.ts",
    "supabase:local:configure": "node ./scripts/configure-local-supabase-env.mjs",
    "supabase:local:status": "node ./scripts/configure-local-supabase-env.mjs --check",
    "supabase:deployment:parity": "node ./scripts/validate-supabase-deployment-parity.mjs --linked",
    "artifact:hygiene": "node ./scripts/report-local-artifact-hygiene.mjs",
    "import:current-plan": "node --env-file=.env.local ./scripts/import-current-plan.mjs",
    "author-ai-first-plan-draft": "node --env-file=.env.local --import tsx ./scripts/author-ai-first-plan-draft.ts",
    "validate-admin-capture-backlog": "node --import tsx ./scripts/validate-admin-capture-backlog.ts",
    "validate-admin-capture-backlog:live": "node --env-file=.env.local --import tsx ./scripts/validate-admin-capture-backlog.ts --live-supabase",
    "validate-changelog-history": "node --import tsx ./scripts/validate-changelog-history-sync.ts",
    "validate-hito-ds-components": "node --import tsx ./scripts/validate-hito-ds-component-contracts.ts",
    "validate-product-contracts": "node --import tsx ./scripts/validate-product-contracts.ts",
    "validate-local-runtime-observability": "node --import tsx ./scripts/validate-local-runtime-observability.ts",
    "validate-manual-workout-authoring": "node --import tsx ./scripts/validate-manual-workout-authoring.ts",
    "validate:backend": "node ./scripts/validate-backend.mjs",
    "validate:backend:local-db": "node --env-file=.env.local ./scripts/validate-backend.mjs --local-db",
    "validate:backend:runtime": "node --env-file=.env.local ./scripts/validate-backend.mjs --runtime --runtime-url=http://127.0.0.1:3000",
    "validate:backend:release": "node ./scripts/validate-backend.mjs --release",
    "import-admin-backlog-work-items": "node --env-file=.env.local --import tsx ./scripts/import-repo-work-items-to-admin-backlog-cli.ts",
    "test-user": "node --env-file=.env.local ./scripts/test-user.mjs",
    "local:design-profile:seed": "node --env-file=.env.local ./scripts/test-user.mjs design-profile-seed",
    "local:design-profile:status": "node --env-file=.env.local ./scripts/test-user.mjs design-profile-status",
    "local:design-profile:reset": "node --env-file=.env.local ./scripts/test-user.mjs design-profile-reset",
    "validate-test-user-lifecycle": "node ./scripts/validate-qa-test-user-lifecycle.mjs",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.112.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-router": "^1.170.19",
    "@tanstack/react-start": "^1.168.36",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fit-file-parser": "^3.0.0",
    "nitro": "^3.0.260610-beta",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "undici": "^7.29.0",
    "vite-tsconfig-paths": "^6.0.2",
    "yauzl": "^3.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "tsx": "^4.23.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.6"
  }
}
